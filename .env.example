# ===== Runtime switch =====
# mysql | postgresql
DB_DIALECT=mysql

# ===== Legacy MySQL runtime vars (compatible with old config) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_me
DB_NAME=news_analysis

# ===== Explicit MySQL source vars (for migration script) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_me
MYSQL_DB_NAME=

# 新 PostgreSQL（作为目标库 + 新运行库）
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=
POSTGRES_SSLMODE=

# 业务 API 密钥（保持你现有值）
TUSHARE_TOKEN=
DOUBAO_API_KEY=
DOUBAO_API_BASE_URL=
DOUBAO_MODEL_ID=
DOUBAO_MODEL_ID_FILTER=
DOUBAO_MODEL_ID_ANALYZE=

# 可选：宏观基线 YAML/JSON 路径（不设则使用 config/macro_baseline.yaml 等默认查找）
# MACRO_BASELINE_PATH=config/macro_baseline.yaml

# ===== 飞书群推送（自定义机器人 Webhook，流水线 analyze 完成后触发）=====
# FEISHU_WEBHOOK_ENABLED=true
# 机器人 Webhook 完整地址，多个群用英文逗号或分号分隔（每群一个机器人则多个 URL）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 展示站根 URL（消息内「详情」链接；不设则默认 goldnews-analysis.easypus.com）
# FEISHU_PUSH_WEB_BASE_URL=https://goldnews-analysis.easypus.com
# FEISHU_PUSH_CONCLUSION_MAX_LEN=400
# FEISHU_PUSH_SEND_DELAY_MS=400
# 未单独设置 FEISHU_PUSH_* 时，可继续用下面的 QQ_PUSH_* 作为文案与间隔的兜底（仅飞书生效项）

# ===== QQ 群推送（可选，go-cqhttp；流水线已默认走飞书，需自行改为 from qq_push import …）=====
# QQ_PUSH_ENABLED=true
# QQ_ONEBOT_HTTP_URL=http://127.0.0.1:5700
# QQ_ONEBOT_ACCESS_TOKEN=
# QQ_GROUP_IDS=
# QQ_PUSH_WEB_BASE_URL=https://goldnews-analysis.easypus.com
# QQ_PUSH_CONCLUSION_MAX_LEN=400
# QQ_PUSH_SEND_DELAY_MS=400



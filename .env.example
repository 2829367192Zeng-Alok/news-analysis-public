# ===== Runtime switch =====
# mysql | postgresql
DB_DIALECT=mysql

# ===== Legacy MySQL runtime vars (compatible with old config) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_me
DB_NAME=news_analysis

# ===== Explicit MySQL source vars (for migration script) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_me
MYSQL_DB_NAME=

# 新 PostgreSQL（作为目标库 + 新运行库）
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=
POSTGRES_SSLMODE=

# 业务 API 密钥（保持你现有值）
TUSHARE_TOKEN=

# ===== 豆包 / 火山引擎 Ark =====
# API Key：在火山引擎控制台「API Key 管理」中获取（即官方示例中的 ARK_API_KEY）
DOUBAO_API_KEY=

# API 基础地址，无需修改
DOUBAO_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型 ID：
#   - 共享 API：填模型名，如 doubao-seed-1-8-251228
#   - 在线推理（独享接入点）：填接入点 ID，如 ep-20250101xxxxxx-xxxxx
#     在控制台「在线推理」→「创建推理接入点」后获取
DOUBAO_MODEL_ID=doubao-seed-1-8-251228

# 筛选与分析可单独指定不同模型/接入点（留空则使用 DOUBAO_MODEL_ID）
DOUBAO_MODEL_ID_FILTER=
DOUBAO_MODEL_ID_ANALYZE=

# 可选：宏观基线 YAML/JSON 路径（不设则使用 config/macro_baseline.yaml 等默认查找）
# MACRO_BASELINE_PATH=config/macro_baseline.yaml

# 提示词版本开关：1/true/yes = 使用 v2（prompts_new：宏观基线 System Prompt + confidence/uncertain 字段）。
# ⚠️ 开启前必须先在生产执行 init_db.py 补齐 confidence/uncertain 两列，否则分析步骤会失败。
# 默认留空 = v1（prompts.py），行为与历史版本一致
# USE_PROMPTS_V2=

# ===== 常驻守护进程 pipeline_daemon.py（替代阿里云 90s 定时触发，二选一）=====
# 轮询间隔秒数（默认 20）
# POLL_INTERVAL_SECONDS=20
# 每轮采集窗口分钟数（默认 2，略大于轮询间隔防漏数据）
# FETCH_WINDOW_MINUTES=2
# 滞留补偿筛选阈值（分钟，默认 30）与单轮补筛上限（默认 15）
# CATCHUP_STALE_MINUTES=30
# CATCHUP_FILTER_LIMIT=15

# ===== 飞书群推送（自定义机器人 Webhook，流水线 analyze 完成后触发）=====
# FEISHU_WEBHOOK_ENABLED=true
# 机器人 Webhook 完整地址，多个群用英文逗号或分号分隔（每群一个机器人则多个 URL）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 展示站根 URL（消息内「详情」链接）。生产环境必须显式设置，勿依赖代码中的默认值；
# 默认 goldnews-analysis.easypus.com 仅为历史兼容
# FEISHU_PUSH_WEB_BASE_URL=https://goldnews-analysis.easypus.com
# FEISHU_PUSH_CONCLUSION_MAX_LEN=400
# FEISHU_PUSH_SEND_DELAY_MS=400

# ===== Flask 动态站（可选）=====
# python app.py 直接运行时是否开启 debug（生产请用 gunicorn 且保持关闭）
# FLASK_DEBUG=1

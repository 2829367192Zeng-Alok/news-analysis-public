# ===== Runtime switch =====
# mysql | postgresql
DB_DIALECT=mysql

# ===== Legacy MySQL runtime vars (compatible with old config) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_me
DB_NAME=news_analysis

# ===== Explicit MySQL source vars (for migration script) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_me
MYSQL_DB_NAME=news_analysis

# ===== PostgreSQL target/runtime vars =====
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_DB_NAME=news_analysis
# Optional: disable/require/verify-ca/verify-full
POSTGRES_SSLMODE=require

